# Application
APP_NAME=social-scheduler
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
PUBLIC_BASE_URL=http://localhost:8000
TIMEZONE=UTC

# Database
# Single-process local option. Do not share this file between the API and a worker.
DATABASE_URL=sqlite:///./local.db
# Docker Compose overrides this with Postgres. Production example:
# DATABASE_URL=postgresql+psycopg://APP_USER:REPLACE_ME@DB_HOST:5432/social_scheduler

# Background jobs
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
# Celery task result storage is disabled; the application does not consume it.
SCHEDULER_POLL_SECONDS=30
POST_MAX_ATTEMPTS=5

# Authentication — replace with long, random, environment-specific values
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=30
# Login responses include a refresh token. The studio exchanges it at POST /api/v1/auth/refresh.
REFRESH_TOKEN_EXPIRE_DAYS=14
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# OAuth: register redirect URLs with each provider.
# Keep real credentials in a secret manager or deployment environment.
# Connect returns HTTP 503 and names the missing variables when a client id/secret is unset.

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:8000/api/v1/accounts/instagram/callback
INSTAGRAM_GRAPH_API_VERSION=v24.0

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8000/api/v1/accounts/linkedin/callback
LINKEDIN_VERSION=202610

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:8000/api/v1/accounts/x/callback

# Facebook Pages (personal profiles are NOT publishable destinations)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=http://localhost:8000/api/v1/accounts/facebook/callback
FACEBOOK_GRAPH_API_VERSION=v21.0

# YouTube (Google OAuth client)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8000/api/v1/accounts/youtube/callback

# TikTok Login Kit and Content Posting API.
# Required: TIKTOK_CLIENT_KEY, TIKTOK_CLIENT_SECRET, TIKTOK_REDIRECT_URI.
# TIKTOK_REDIRECT_URI must exactly match a redirect URI registered for this app
# in the TikTok developer portal (Login Kit). The connect flow sends PKCE:
# code_challenge is the hex SHA-256 of a per-request code_verifier (not base64url).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/api/v1/accounts/tiktok/callback

# Pinterest
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=
PINTEREST_REDIRECT_URI=http://localhost:8000/api/v1/accounts/pinterest/callback

# Meta Threads API
THREADS_CLIENT_ID=
THREADS_CLIENT_SECRET=
THREADS_REDIRECT_URI=http://localhost:8000/api/v1/accounts/threads/callback
THREADS_API_VERSION=v1.0

# Token encryption key: separate from SECRET_KEY; use a KMS/secret manager in production.
TOKEN_ENCRYPTION_KEY=REPLACE_WITH_KEY_FROM_APPROVED_CRYPTOGRAPHIC_GENERATOR

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=


# Phase C publish notes (no new required keys beyond connect):
# - PUBLIC_BASE_URL must be a public https origin when Facebook/Pinterest/Threads/TikTok
#   need to fetch /static/uploads media. Localhost will fail those providers' fetch checks.
# - YouTube uploads use the same YOUTUBE_* OAuth client; ensure YouTube Data API v3 is enabled
#   and the consent screen includes youtube.force-ssl (and ideally youtube.upload).
# - TikTok Direct Post may stay SELF_ONLY / inbox-only until the TikTok app completes audit.
# - FACEBOOK_GRAPH_API_VERSION / THREADS_API_VERSION control Graph host version strings used by publishers.
